{
  "Routes": [
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7092
        }
      ],
      "UpstreamPathTemplate": "/identity/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete", "Options" ],
      "SwaggerKey": "identity",
      "DangerousAcceptAnyServerCertificateValidator": true
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7210
        }
      ],
      "UpstreamPathTemplate": "/policy/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete", "Options" ],
      "SwaggerKey": "policy",
      "DangerousAcceptAnyServerCertificateValidator": true
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "all",
      "Config": [
        {
          "Name": "All SmartSure Services",
          "Version": "v1"
        }
      ]
    },
    {
      "Key": "identity",
      "TransformByOcelotConfig": true,
      "DangerousAcceptAnyServerCertificateValidator": true,
      "Config": [
        {
          "Name": "Identity Service API",
          "Version": "v1",
          "Url": "https://localhost:7092/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "policy",
      "TransformByOcelotConfig": true,
      "DangerousAcceptAnyServerCertificateValidator": true,
      "Config": [
        {
          "Name": "Policy Service API",
          "Version": "v1",
          "Url": "https://localhost:7210/swagger/v1/swagger.json"
        }
      ]
    }
  ],
  "AggregateDocs": [
    {
      "Key": "all",
      "Config": [
        {
          "SwaggerKey": "identity"
        },
        {
          "SwaggerKey": "policy"
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:9000"
  }
}
