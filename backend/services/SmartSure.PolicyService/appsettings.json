{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "MassTransit": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "PolicyConnDb": "PLACEHOLDER_LOADED_FROM_ENV"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "PLACEHOLDER_LOADED_FROM_ENV",
    "Issuer": "IdentityService",
    "Aud1": "SmartSure.IdentityService",
    "Aud2": "SmartSure.AdminService",
    "Aud3": "SmartSure.ClaimsService",
    "Aud4": "SmartSure.PolicyService",
    "Aud5": "SmartSure.Gateway"
  }
}

