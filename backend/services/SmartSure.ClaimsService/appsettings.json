{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning",
        "MassTransit": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "ClaimsConnDb": "PLACEHOLDER_LOADED_FROM_ENV"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "PLACEHOLDER_LOADED_FROM_ENV",
    "Issuer": "IdentityService",
    "Audience": "SmartSureSystem"
  }
}
